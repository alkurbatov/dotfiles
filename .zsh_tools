# Purpose:
# Handy zsh commands and functions.


# Create a new directory and enter it.
mkcd() {
    mkdir -pv "$1" && cd "$1"
}


# Colored man pages.
man() {
    env \
    LESS_TERMCAP_mb=$(printf "\e[1;36m") \
    LESS_TERMCAP_md=$(printf "\e[1;36m") \
    LESS_TERMCAP_me=$(printf "\e[0m") \
    LESS_TERMCAP_se=$(printf "\e[0m") \
    LESS_TERMCAP_so=$(printf "\e[1;44;33m") \
    LESS_TERMCAP_ue=$(printf "\e[0m") \
    LESS_TERMCAP_us=$(printf "\e[1;32m") \
    man "$@"
}


# Extracts archived files / mounts disk images.
# Usage: extract <file>
# Credit: http://nparikh.org/notes/zshrc.txt
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.Z)        uncompress "$1"                         ;;
            *.ZIP)      unzip "$1"                              ;;
            *.bz2)      bunzip2 "$1"                            ;;
            *.dmg)      hdiutil mount "$1"                      ;;
            *.gz)       gunzip -k "$1"                          ;;
            *.pax)      pax -r < "$1"                           ;;
            *.pax.Z)    uncompress "$1" --stdout | pax -r       ;;
            *.rar)      unrar x "$1"                            ;;
            *.tar)      tar -xvf "$1"                           ;;
            *.tar.bz2)  tar -jxvf "$1"                          ;;
            *.tar.gz)   tar -zxvf "$1"                          ;;
            *.tbz2)     tar -jxvf "$1"                          ;;
            *.tgz)      tar -zxvf "$1"                          ;;
            *.zip)      unzip "$1"                              ;;
            *)          echo "'$1' cannot be extracted/mounted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}


# Generate new SSH key.
# Usage: sshcreate <key_name> <comment>
sshcreate() {
    if [[ -n "$1" && -n "$2" ]]; then
        ssh-keygen -f $HOME/.ssh/$1 -t ed25519 -N '' -C "$2"
        chmod 600 $HOME/.ssh/$1
        chmod 644 $HOME/.ssh/$1.pub
    else
        echo "Please specify key's name and commentary."
    fi
}

# Create git branch from origin branch with the same name.
gcob() {
    git checkout -b "$1" "origin/$1"
}

# Cleans py[cod] and cache directories in the current tree.
pyclean() {
    find . \
        | grep -E "(__pycache__|\.(mypy_)?cache|\.hypothesis|\.py[cod]$)" \
        | xargs rm -rf
}

# Clean intermediate Docker images, unused volumes, networks and cache.
docker-clean() {
    docker image prune -f && \
        docker volume prune -f && \
        docker network prune -f && \
        docker builder prune -f
}

if [[ "$OSTYPE" = linux* ]]; then

# Get full list of ports opened in firewalld for registered services.
fports() {
    for i in $(sudo firewall-cmd --list-services); do
        echo "\n$i:"
        sudo firewall-cmd --permanent --service "$i" --get-ports;
    done
}

# macOS-like convenient open.
open() {
    if [ -f "$1" ]; then
        case "$1" in
            *.gz)    gunzip -k "$1" 2>/dev/null           ;;
            *.html)  firefox "$1" 2>/dev/null             ;;
            *.jpg)   gwenview "$1" 2>/dev/null            ;;
            *.mp4)   mpv "$1" 2>/dev/null                 ;;
            *.pdf)   okular "$1" 2>/dev/null              ;;
            *.png)   gwenview "$1" 2>/dev/null            ;;
            *.rar)   unrar x "$1"                         ;;
            *.zip)   unzip "$1"                           ;;
            *)       echo "'$1' cannot process with open" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# Drop all data from swap.
swapflush() {
    sudo swapoff -a
    sudo swapon -a
}

fi

if [[ "$OSTYPE" = darwin* ]]; then

# Update and upgrade Homebrew and it's casks.
brew-upgrade() {
    brew update && brew upgrade && brew upgrade --cask
}

fi
